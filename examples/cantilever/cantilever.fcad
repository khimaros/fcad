# -*- mode: python -*- vim: ft=python
"""a steel cantilever beam: the smallest project that exercises `fcad fem`.

boiled down to one part, so the FEM descriptor is the whole point. the beam is
fixed at its -X end and pulled down by a force on its +X end, which is the
textbook cantilever: tip deflection is F*L^3 / (3*E*I) and root bending stress is
M*c / I, so the solve can be checked against theory rather than just eyeballed.

faces are picked by geometry predicate, never by a "FaceN" index that reorders the
moment the geometry changes. `MATERIAL` states steel once at project level, so the
case need not repeat it. a case that declares `loads` gets `self_weight` off by
default, which keeps this comparable to the closed-form beam.

a force's `magnitude` is in N and its `direction` is a signed axis, independent of
which face carries it. the other kind, `{"kind": "pressure"}`, is in MPa and acts
along the loaded face's own normal instead (`reversed` flips it), so it takes no
direction. lengths are mm throughout.

no `mesh_size` is declared: fcad meshes 2nd order, which is accurate enough on a
plain prismatic beam that the inferred default (bbox diagonal / 20) lands inside
1% of the closed form. a part with small features usually wants one stated.

`fcad fem` writes dist/<target>.fem.{FCStd,npz}; `--modal` adds eigenmodes. it
needs gmsh and ccx on PATH.
"""

from fcad import fem_select as fs
import fcad, Part, FreeCAD as App

PARAMS = {"length": 300.0, "width": 30.0, "height": 20.0, "tip_load": 500.0}

# floats become PropertyLength (fcad models mm geometry), so the one parameter
# that is a force rather than a dimension says so.
PARAM_META = {"tip_load": {"type": "float"}}

MATERIAL = "steel"

# one case for every target, so both `fcad fem` (the assembly) and `fcad fem beam`
# resolve.
FEM = {"__default__": {
    "fixed": [fs.min_along("x")],
    "loads": [{"faces": fs.max_along("x"), "magnitude": PARAMS["tip_load"],
               "direction": "-z"}],
}}


def _outline(length, width):
    l, w = length / 2.0, width / 2.0
    return [(-l, -w), (l, -w), (l, w), (-l, w)]


def _solid(points, height):
    face = Part.Face(Part.makePolygon(
        [App.Vector(x, y, -height / 2.0) for x, y in points + points[:1]]))
    return face.extrude(App.Vector(0, 0, height))


def compute(p):
    points = _outline(p["length"], p["width"])
    return [fcad.Part("beam", profile="%gx%g bar" % (p["width"], p["height"]),
                      placements=[App.Placement()],
                      solid=lambda: _solid(points, p["height"]),
                      profile2d=(points, p["height"]))]
