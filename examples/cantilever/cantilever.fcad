# -*- mode: python -*- vim: ft=python
"""a steel cantilever beam: the smallest project that exercises `fcad fem`.

fixed at its -X end and pulled down by a force on its +X end, which is the
textbook cantilever: tip deflection is F*L^3 / (3*E*I) and root bending stress
is M*c / I. `magnitude` is a callable `lambda p: p["tip_load"]` so edits to
`tip_load` in the VarSet or via FEM `params` take effect immediately.
"""

import fcad
from fcad import fem_select as fs
from fcad.freecad import partdesign

COL_STEEL = (0.55, 0.58, 0.63)

PARAMS = {"length": 300.0, "width": 30.0, "height": 20.0, "tip_load": 500.0}

PARAM_META = {"tip_load": {"type": "float"}}

MATERIAL = "steel"

FEM = {"__default__": {
    "fixed": [fs.min_along("x")],
    "loads": [{"faces": fs.max_along("x"),
               "magnitude": lambda p: p["tip_load"],
               "direction": "-z"}],
}}


def _outline(length, width):
    l, w = length / 2.0, width / 2.0
    return [(-l, -w), (l, -w), (l, w), (-l, w)]


def _beam(doc, body, length, width, height):
    partdesign.pad_and_bore(doc, body, _outline(length, width), height)


def compute(p):
    l, w, h = p["length"], p["width"], p["height"]
    return [fcad.PartSpec("beam", profile="%gx%g bar" % (w, h), length=l,
                          color=COL_STEEL,
                          build=lambda doc, body: _beam(doc, body, l, w, h))]
