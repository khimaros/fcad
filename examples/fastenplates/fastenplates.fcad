# -*- mode: python -*- vim: ft=python
"""two lapped plates held together by one screw: a minimal fcad assembly.

both plates are the *same* part placed twice, the second rotated 180 degrees
about Z, so a single drilled sketch serves both ends of the lap and the bom reads
one row of qty 2. `plate` is flagged `grounded`, so `check` runs its full
support assertion rather than skipping it.

both parts are PartDesign bodies, and both come from a `build` that is handed a
live document and an empty body. the plate calls `partdesign.pad_and_bore`; the
screw writes plain FreeCAD calls itself (`PartDesign::Revolution` of a
half-section). fcad has no vocabulary in the way, so general FreeCAD Python
knowledge applies directly.

`STOCK` is a callable `(p) -> dict`, so sweeping `plate_wid` or `plate_thk`
still matches `plate`'s bom profile instead of going stale on import-time
defaults. `CONSTRAINTS` stops `fcad optimize plate_len overlap` from shrinking
the joint below its stated reach.
"""

from FreeCAD import Placement, Rotation, Vector

import fcad
from fcad import types
from fcad.freecad import partdesign

HEAD_DIA = 2.0
HEAD_THK = 0.7
BORE = 1.0
MIN_MARGIN = 1.0
COL_PLATE = (0.72, 0.75, 0.79)
COL_SCREW = (0.32, 0.35, 0.40)

PARAMS = {"plate_len": 100.0, "plate_wid": 40.0, "plate_thk": 10.0,
          "overlap": 40.0, "screw_dia": 6.0, "reach": 160.0}


def _section(width, thickness):
    return "bar %gx%g" % (width, thickness)


# reactive stock catalog: keyed off live parameters, so sweeping plate_wid or
# plate_thk still plans the right bar. the screw stays off the shopping list.
STOCK = lambda p: {
    _section(p["plate_wid"], p["plate_thk"]): [(200.0, 4.50), (300.0, 6.00)],
}

CONSTRAINTS = [
    lambda p, d: (d["reach"] >= p["reach"]
                  or "the joint only reaches %.0f mm of %.0f"
                  % (d["reach"], p["reach"])),
    lambda p, d: (d["lap_margin"] >= MIN_MARGIN * p["screw_dia"]
                  or "only %.1f mm of plate around the screw"
                  % d["lap_margin"]),
]


def _outline(length, width):
    l, w = length / 2.0, width / 2.0
    return [(-l, -w), (l, -w), (l, w), (-l, w)]


def _plate(doc, body, points, thickness, bore):
    partdesign.pad_and_bore(doc, body, points, thickness, [bore])


def _screw(doc, body, dia, grip):
    """the screw's half-section revolved 360 deg about Z in plain FreeCAD."""
    sr, hr, ht = dia / 2.0, dia * HEAD_DIA / 2.0, dia * HEAD_THK
    profile = [(0.0, ht), (hr, ht), (hr, 0.0), (sr, 0.0), (sr, -grip), (0.0, -grip)]
    sketch = partdesign.add_sketch(
        doc, body, "screw_profile", points=profile,
        placement=Placement(Vector(0, 0, 0), Rotation(Vector(1, 0, 0), 90)))
    turn = body.newObject(types.PartDesign.Revolution, "screw_turn")
    turn.Profile = sketch
    turn.ReferenceAxis = (sketch, ["V_Axis"])
    turn.Angle = 360.0
    doc.recompute()


def compute(p):
    l, w, t = p["plate_len"], p["plate_wid"], p["plate_thk"]
    ov, d = p["overlap"], p["screw_dia"]
    off = (l - ov) / 2.0
    grip = 2.0 * t
    hole = (off, 0.0, d * BORE)
    points = _outline(l, w)
    specs = [
        fcad.PartSpec("plate", profile=_section(w, t), length=l,
                      grounded=True, color=COL_PLATE,
                      placements=[
                          Placement(Vector(-off, 0, -t / 2.0), Rotation()),
                          Placement(Vector(off, 0, t / 2.0),
                                    Rotation(Vector(0, 0, 1), 180))],
                      build=lambda doc, body: _plate(doc, body, points, t, hole),
                      openings=["*_bore*"]),
        fcad.PartSpec("screw", profile="m%g screw" % d, length=grip,
                      placements=Placement(Vector(0, 0, t), Rotation()),
                      embeds=True, color=COL_SCREW,
                      build=lambda doc, body: _screw(doc, body, d, grip)),
    ]
    return {"specs": specs,
            "reach": 2.0 * l - ov,
            "lap_margin": (ov - d) / 2.0}
