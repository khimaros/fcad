# -*- mode: python -*- vim: ft=python
"""a hexagonal plate with a vertical hole through its center.

the smallest project on fcad's well-lit path. `build` gets a live document and an
empty `PartDesign::Body`, and what goes in is plain FreeCAD: a fully-constrained
sketch, a `Pad`, a `PartDesign::Hole`. open `dist/parts/hex.FCStd` and the
feature tree is there to edit.

nothing here describes the part twice. the bore is a Hole feature, so fcad reads
it back out of the tree rather than being told about it separately - that is what
`dimension_sketches` means: not "there is a 20 mm circle at the origin" but "the
circles in *that* sketch belong on the drawing". a dimension cannot disagree with
a bore it was read from.

`openings` is the one thing the geometry cannot say. `check` asks whether a part
gave up material nothing fills, which is the right question for a lap cut twice
as wide as the member crossing it and the wrong one for a nut - the hole is the
point. both are just a feature that removed material, so the project says which
is which.

`pad_and_bore` is the shape most parts are, offered as a helper to call from
`build`. it is not a layer: it makes the same calls this file could make inline,
and the screw in `fastenplates` ignores it entirely.

the sketch lies in XY at z = -thickness/2, so a circle in it is already a
vertical bore. the outline is centered on the origin by construction rather than
translated, so the assembly's placement cannot shift the part.
"""

import math

# `Placement` is FreeCAD's own: it imports by name because a .fcad is executed
# inside FreeCAD, and fcad injects nothing into a project's namespace.
from FreeCAD import Placement

import fcad
from fcad.freecad import partdesign

SIDES = 6

PARAMS = {"across_flats": 75.0, "thickness": 30.0, "hole_dia": 20.0}


def _outline(across_flats):
    r = across_flats / math.sqrt(3.0)
    step = 2.0 * math.pi / SIDES
    return [(r * math.cos(i * step), r * math.sin(i * step)) for i in range(SIDES)]


def _hex(doc, body, across_flats, thickness, hole_dia):
    """the outline padded, with one bore through the middle."""
    partdesign.pad_and_bore(doc, body, _outline(across_flats), thickness,
                            [(0.0, 0.0, hole_dia)], name="hex")


def compute(p):
    af, t, d = p["across_flats"], p["thickness"], p["hole_dia"]
    return [fcad.PartSpec("hex", placements=[Placement()],
                          build=lambda doc, body: _hex(doc, body, af, t, d),
                          dimension_sketches=["hex_bore1"],
                          openings=["hex_bore1"])]
