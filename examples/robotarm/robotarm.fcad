# -*- mode: python -*- vim: ft=python
"""a 3-DOF articulated desktop robotic arm exercising all of fcad's capabilities.

exercises both the core contract and the extended capabilities:
- topology-safe edge predicates (`fcad.geom_select`) and curved/slotted sketches
- kinematic `MOTION` sweeps checked dynamically and animated (`--subject motion`)
- multi-material CompSolid + multi-pose `FEM` (`al6061`, `steel1045`, `bronze`,
  `polycarbonate`, `rubber`)
- 1D bar/rod stock alongside 2D `fcad.Sheet` nesting and K-factor sheet-metal
  flat-pattern unfolding (`fcad.sheetmetal`)
- reusable `fcad.SubAssembly` joint kits, imported COTS STEP motor (`from_step`),
  and handed left/right forearm twins grouped via `bom_group`
- price- and mass-coupled `optimize` plus `PartDesign::Hole` callouts and
  assembly BOM tables on TechDraw drawings
"""

import os

from FreeCAD import Placement, Rotation, Vector

import fcad
from fcad import fem_select as fs, geom_select as gs, sheetmetal, types
from fcad.freecad import build_assembly as asmlib, partdesign

HERE = os.path.dirname(os.path.abspath(__file__))
MOTOR_STEP = os.path.join(HERE, "nema17.step")

# fixed geometric proportions (mm) shared across mating parts.
FOOT_H = 6.0
FOOT_SIZE = 20.0
FOOT_INSET = 16.0
FRAME_W = 18.0
COVER_GAP = 2.0
TURRET_PED_DIA = 60.0
COVER_HOLE_DIA = 68.0
TURRET_DECK_DIA = 82.0
TURRET_DECK_THK = 10.0
EAR_PIVOT_H = 26.0
EAR_TOP_R = 16.0
FOREARM_THK = 8.0
PIN_HEAD_ADD = 6.0
PIN_HEAD_THK = 4.0
CAP_DIA = 16.0
CAP_THK = 3.0
M5_DIA = 5.0
M3_DIA = 3.0
HEAD_SCALE = 1.8
HEAD_H_SCALE = 0.7
M3_GRIP = 10.0
WRIST_FLANGE_T = 8.0
WRIST_RAIL_W = 76.0
WRIST_RAIL_H = 22.0
JAW_THK = 14.0
JAW_FINGER_W = 6.0
JAW_BOLT_OFF = 3.0
JAW_HEEL_T = 4.0
JAW_LEN = 36.0
JAW_H = 18.0
JAW_TIP_T = 4.0
MIN_REACH = 220.0
MIN_LIGAMENT = 8.0
MIN_GROUND_Z = 16.0
CHAMFER_SM = 0.8
CABLE_PORT_W = 24.0
CABLE_PORT_H = 14.0
CABLE_CLIP_DIA = 4.0
BEND_R = 2.0

# palette for `fcad render` and `fcad animate`: distinct per material role.
COL_RUBBER = (0.14, 0.14, 0.16)
COL_AL_RAW = (0.74, 0.77, 0.81)
COL_AL_BLUE = (0.20, 0.42, 0.64)
COL_AL_DARK = (0.24, 0.27, 0.32)
COL_STEEL = (0.48, 0.51, 0.56)
COL_BRONZE = (0.78, 0.58, 0.25)
COL_JAW = (0.86, 0.36, 0.14)
COL_COVER = (0.68, 0.84, 0.96)
COL_BOLT = (0.30, 0.33, 0.38)
COL_MOTOR = (0.18, 0.20, 0.24)

# densities (g/mm^3) for fast analytic `mass_g` thunks during `optimize --objective mass`.
RHO_AL = 2.70e-3
RHO_STEEL = 7.85e-3
RHO_BRONZE = 8.80e-3
RHO_PC = 1.20e-3
RHO_RUBBER = 1.15e-3

PARAMS = {
    "base_wid": 160.0,
    "base_h": 46.0,
    "wall_thk": 6.0,
    "upper_len": 150.0,
    "forearm_len": 130.0,
    "link_wid": 34.0,
    "link_thk": 10.0,
    "pin_dia": 10.0,
    "bushing_od": 16.0,
    "theta_base": 20.0,
    "theta_shoulder": 25.0,
    "theta_elbow": 55.0,
    "jaw_open": 24.0,
    "payload_n": 15.0,
    "gripper_style": "parallel",
