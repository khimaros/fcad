PARAM_META = {
    "base_wid": {"group": "Base", "min": 120.0, "max": 260.0},
    "base_h": {"group": "Base", "min": 36.0, "max": 80.0},
    "wall_thk": {"group": "Base", "min": 4.0, "max": 12.0},
    "upper_len": {"group": "Arm", "min": 100.0, "max": 240.0},
    "forearm_len": {"group": "Arm", "min": 90.0, "max": 220.0},
    "link_wid": {"group": "Arm", "min": 24.0, "max": 50.0},
    "link_thk": {"group": "Arm", "min": 6.0, "max": 16.0},
    "pin_dia": {"group": "Joints", "min": 6.0, "max": 16.0},
    "bushing_od": {"group": "Joints", "min": 12.0, "max": 22.0},
    "theta_base": {"type": "angle", "group": "Pose", "min": -180.0, "max": 180.0},
    "theta_shoulder": {"type": "angle", "group": "Pose", "min": -45.0, "max": 75.0},
    "theta_elbow": {"type": "angle", "group": "Pose", "min": -90.0, "max": 120.0},
    "jaw_open": {"group": "Gripper", "min": 6.0, "max": 44.0},
    "payload_n": {"type": "float", "group": "Loads", "min": 1.0, "max": 100.0},
    "gripper_style": {"group": "Gripper", "choices": ["parallel", "wide"]},
