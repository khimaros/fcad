def _bar_label(w, t):
    return "al bar %gx%g" % (w, t)


def _rod_label(d):
    return "steel rod %g" % d


def _plate_label(t):
    return "al sheet %gmm" % t


def _pc_label(t):
    return "pc sheet %gmm" % t


STOCK = lambda p: {
    # 1D linear bar and rod stock.
    _bar_label(p["link_wid"], p["link_thk"]): [
        (300.0, 8.50), (500.0, 13.00)],
    _bar_label(p["link_wid"], FOREARM_THK): [
        (300.0, 7.20), (500.0, 11.00)],
    _rod_label(p["pin_dia"]): [(200.0, 5.00), (300.0, 7.00)],
    # 2D sheet stock for the base plate, unfolded shell tray, and polycarbonate lid.
    _plate_label(p["wall_thk"]): [
        fcad.Sheet(400.0, 300.0, price=24.00),
        fcad.Sheet(600.0, 400.0, price=42.00)],
    _pc_label(p["wall_thk"]): [
        fcad.Sheet(300.0, 200.0, price=12.00)],
}

MATERIALS = {
    "al6061": {"E": 68900.0, "nu": 0.33, "rho": 2700.0},
    "steel1045": {"E": 205000.0, "nu": 0.29, "rho": 7850.0},
    "bronze": {"E": 110000.0, "nu": 0.34, "rho": 8800.0},
    "polycarbonate": {"E": 2300.0, "nu": 0.37, "rho": 1200.0},
    "rubber": {"E": 50.0, "nu": 0.45, "rho": 1150.0},
}
MATERIAL = "al6061"

FEM = {
    "assembly": {
        "undrilled": True,
        "fixed": [fs.min_along("z")],
        "loads": [{"faces": fs.max_along("x"),
